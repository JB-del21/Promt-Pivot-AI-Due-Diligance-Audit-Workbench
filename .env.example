# Development example only. Never commit .env with real secrets.
# Server-only environment variables. Never add VITE_, PUBLIC_, or NEXT_PUBLIC_ prefixes.
PORT=3000
NODE_ENV=development

# Trusted RSA-signed JWT identity provider (required for protected routes).
# Use literal \n separators for the PEM in a single environment variable value.
AUTH_JWT_PUBLIC_KEY=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=

# Server-only PostgreSQL credentials. For DB integration tests use an isolated
# database literally named prompt_pivot_test, never a production database.
DATABASE_URL=

# Optional: paid Gemini live benchmarks fail closed if absent.
GEMINI_API_KEY=
